LINKEDIN_JOBS_URL=https://www.linkedin.com/jobs/search/?keywords=Frontend%20Engineer
PROFILE_KEYWORDS=frontend,react,next.js,typescript,staff,lead,engineering manager
EXCLUDE_KEYWORDS=intern,contract,qa,salesforce
EXCLUDE_COMPANIES=walmart,walmart-global-tech-india,my-current-company
MAX_JOBS=50
USE_START_PAGINATION=true
JOBS_PAGE_SIZE=25
MAX_CONTACTS_PER_JOB=5
ACTION_DELAY_MIN_MS=1200
ACTION_DELAY_MAX_MS=2800
JOB_DELAY_MIN_MS=4000
JOB_DELAY_MAX_MS=9000
SCROLL_DELAY_MIN_MS=900
SCROLL_DELAY_MAX_MS=2200
KEEP_BROWSER_OPEN=false
DRY_RUN=true
RESUME_URL=https://bit.ly/dhruvrana
CANDIDATE_NAME=Dhruv Rana
CANDIDATE_SIGNATURE=Dhruv
NOTE_TEMPLATE=Hi {FirstName}, I came across the {JobTitle} role and it aligns with my profile. If my background is relevant, would you be open to referring me? Resume: {ResumeUrl} | Job: {JobUrl} | Thanks - {Signature}

SENT_THRESHOLD_PER_JOB=5
EXPERIENCE_FILTER_ENABLED=true
PREFERRED_MIN_YEARS=5
PREFERRED_MAX_YEARS=9
CANDIDATE_YEARS=7
INTERNSHIP_YEARS=1
INTERNSHIP_WEIGHT=1
MAX_NOTE_CHARS=300
USE_GPT_MESSAGE=true
GPT_TIMEOUT_MS=12000
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-pro

SENT_THRESHOLD_PER_COMPANY=5
MIN_COMPANY_MEMBERS=100
