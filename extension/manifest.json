{
  "manifest_version": 3,
  "name": "LinkedIn Job Outreach",
  "version": "1.1.0",
  "description": "Review LinkedIn job contacts or post engagers and send selected connection requests.",
  "permissions": ["tabs", "storage", "sidePanel", "scripting"],
  "host_permissions": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "LinkedIn Job Outreach", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "content_scripts": [{
    "matches": [
      "https://www.linkedin.com/jobs/*",
      "https://www.linkedin.com/company/*",
      "https://www.linkedin.com/feed/update/*",
      "https://www.linkedin.com/posts/*",
      "https://www.linkedin.com/in/*",
      "https://linkedin.com/jobs/*",
      "https://linkedin.com/company/*",
      "https://linkedin.com/feed/update/*",
      "https://linkedin.com/posts/*",
      "https://linkedin.com/in/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
